# =========================================================================
# ENVIRONMENT VARIABLES EXAMPLE
# =========================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to: .env (or .env.local)
# 2. Fill in your ACTUAL values
# 3. .env is in .gitignore (NEVER commit it to git)
#
# This file shows all available environment variables.
# For production, set these in your deployment environment.
# =========================================================================

# ===============================
# Database Configuration
# ===============================
# Used by application.properties
DB_PASSWORD=YOUR_ACTUAL_POSTGRES_PASSWORD_HERE

# Used by application-prod.properties
DATABASE_URL=jdbc:postgresql://localhost:5433/Event_Booking_App_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=YOUR_ACTUAL_POSTGRES_PASSWORD_HERE

# ===============================
# Keycloak Configuration
# ===============================
KEYCLOAK_SERVER_URL=http://localhost:9090
KEYCLOAK_ISSUER_URI=http://localhost:9090/realms/event-ticket-platform
KEYCLOAK_REALM=event-ticket-platform
KEYCLOAK_CLIENT_ID=event-ticket-platform-app
KEYCLOAK_CLIENT_SECRET=YOUR_ACTUAL_KEYCLOAK_CLIENT_SECRET_HERE
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=YOUR_ACTUAL_KEYCLOAK_ADMIN_PASSWORD_HERE

# ===============================
# Application Configuration
# ===============================
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=dev
PORT=8081

# Avoid invalid legacy timezone aliases (for example Asia/Calcutta)
JAVA_TOOL_OPTIONS=-Duser.timezone=Asia/Kolkata

# Optional platform/env overrides
CORS_ALLOWED_ORIGINS=http://localhost:3000
BREVO_API_KEY=your_brevo_api_key_here
MAIL_FROM_EMAIL=noreply@eventbooking.com
MAIL_FROM_NAME=Event Booking Platform
MAIL_ENABLED=true

# ===============================
# Rate Limiting (Production)
# ===============================
RATE_LIMITING_ENABLED=true
RATE_LIMITING_REQUESTS_PER_MINUTE=1000
RATE_LIMITING_AUTH_REQUESTS_PER_MINUTE=10

# ===============================
# Test Database (Optional)
# ===============================
TEST_DATABASE_URL=jdbc:postgresql://localhost:5433/Event_Booking_App_db_test
TEST_DATABASE_USERNAME=postgres
TEST_DATABASE_PASSWORD=YOUR_TEST_DB_PASSWORD_HERE
TEST_KEYCLOAK_ADMIN_USERNAME=admin
TEST_KEYCLOAK_ADMIN_PASSWORD=test_admin_password_change_me
